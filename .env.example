# PSOVA / NVAR environment template. Copy to .env for local development.
# Never commit real credentials. Server credentials must never use NEXT_PUBLIC_ or VITE_ prefixes.

# Database (Hostinger MariaDB / MySQL). Keep a low connection limit on shared hosting.
DATABASE_URL="mysql://user:pass@localhost:3306/psova?connection_limit=5&pool_timeout=20"

# Canonical site and Better Auth
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
BETTER_AUTH_SECRET="change-me-32-plus-random-chars"
BETTER_AUTH_URL="http://localhost:3000"

# NVAR field-level encryption. Generate two different 32-byte base64 keys and back them up offline.
REGISTRY_ENCRYPTION_KEY="base64-of-32-random-bytes"
REGISTRY_INDEX_KEY="base64-of-32-different-random-bytes"

# Centre uploads (clinical photos / reports), stored AES-256-GCM encrypted on disk.
# Absolute path OUTSIDE the deploy directory and never under public/: deploys replace .next and
# public, and anything under public is world-readable. Back it up with the database.
# Leave empty to switch uploads off.
UPLOAD_DIR=""
# Per-centre storage cap in MB (default 2048).
UPLOAD_QUOTA_MB="2048"

# Registry SMTP; registry mail features degrade gracefully if omitted.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="registry@psova.org.pk"
SMTP_PASS="mailbox-password"
SMTP_FROM="PSOVA Registry <registry@psova.org.pk>"

# Registry seed only
ADMIN_EMAIL="admin@psova.org.pk"
ADMIN_PASSWORD="change-me-strong"
ADMIN_NAME="PSOVA Admin"

# Public mobile build configuration
VITE_API_BASE="https://psova.org.pk"

# Public contact delivery uses the same Hostinger SMTP_* mailbox as the registry (above).
# Recipient of contact-form mail; defaults to SMTP_USER when empty.
PSOVA_CONTACT_TO=""

# Contact idempotency, rate limits and push registrations live in the Hostinger MariaDB
# (DATABASE_URL above); tables kv_entry / kv_member create themselves on first use.
RATE_LIMIT_HMAC_KEY=""

# OPTIONAL remote push. FCM is Google's service and cannot be hosted on Hostinger; leave empty to run with no external services.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
PUSH_PUBLISH_SECRET=""
PUSH_TOKEN_ENCRYPTION_KEY=""

# Leave unset on Hostinger managed Node.js. Set to 1 only for Docker/VPS standalone output.
DOCKER_BUILD=""
