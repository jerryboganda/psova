# ---------------------------------------------------------------------------
# NVAR — National Vascular Anomaly Registry · environment variables
# Copy to `.env` for local dev and fill real values. On Hostinger, set these in
# hPanel → website → Settings & Redeploy → Environment variables (import a .env).
# NEVER commit a real `.env`. See docs/registry/DEPLOYMENT-HOSTINGER.md §3.
# ---------------------------------------------------------------------------

# --- Database (Hostinger MariaDB / MySQL) ---
# Keep connection_limit=5 — Hostinger shared MySQL caps max_user_connections (~25).
DATABASE_URL="mysql://user:pass@localhost:3306/psova?connection_limit=5&pool_timeout=20"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # canonical https origin in production

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET="change-me-32-plus-random-chars"
BETTER_AUTH_URL="http://localhost:3000"        # canonical origin, https in production

# --- Registry crypto (SECURITY.md §2.2 — BACK THESE UP OFFLINE!) ---
# Generate each: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The two keys MUST be different. Losing REGISTRY_ENCRYPTION_KEY = permanent PII loss.
REGISTRY_ENCRYPTION_KEY="base64-of-32-random-bytes"
REGISTRY_INDEX_KEY="base64-of-32-random-bytes-DIFFERENT-from-encryption-key"

# --- Mail (Hostinger SMTP; optional — features degrade gracefully if unset) ---
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="registry@psova.org.pk"
SMTP_PASS="mailbox-password"
SMTP_FROM="PSOVA Registry <registry@psova.org.pk>"

# --- Seed (only needed when running `npm run db:seed`) ---
ADMIN_EMAIL="admin@psova.org.pk"
ADMIN_PASSWORD="change-me-strong"
ADMIN_NAME="PSOVA Admin"

# DOCKER_BUILD is NOT set on Hostinger (standalone off → `next start` works).
# Set DOCKER_BUILD=1 only for the VPS/Docker fallback build.
