// NVAR — National Vascular Anomaly Registry schema.
// Source of truth: docs/registry/DATA-MODEL.md §2. Provider: mysql (Hostinger MariaDB).
// Legend: 🔐 = AES-256-GCM ciphertext (v1.<iv>.<tag>.<ct>) in @db.Text; # = HMAC blind index.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// ---------------- Better Auth (required models) ----------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("clinician") // 'admin' | 'clinician' | 'center'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions         Session[]
  accounts         Account[]
  clinicianProfile ClinicianProfile?
  centerMember     CenterMember?
  encounters       Encounter[]
  mdtPosts         MdtPost[]
  mdtComments      MdtComment[]
  auditLogs        AuditLog[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// ---------------- Registry domain ----------------

enum RegistryStatus {
  PENDING
  VERIFIED
  REJECTED
  DUPLICATE
}

enum RecordSource {
  SELF // family self-enrollment
  CLINICIAN // submitted by approved clinician
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Province {
  PUNJAB
  SINDH
  KHYBER_PAKHTUNKHWA
  BALOCHISTAN
  GILGIT_BALTISTAN
  AZAD_JAMMU_KASHMIR
  ISLAMABAD_CAPITAL_TERRITORY
}

enum Onset {
  BIRTH
  INFANCY // < 1 year
  CHILDHOOD // 1–12
  ADOLESCENCE // 13–18
  ADULTHOOD // > 18
  UNKNOWN
}

enum IssvaCategory {
  BENIGN_TUMOR
  BORDERLINE_TUMOR
  MALIGNANT_TUMOR
  SIMPLE_MALFORMATION
  COMBINED_MALFORMATION
  MAJOR_VESSEL_ANOMALY
  SYNDROMIC
  UNCLASSIFIED
}

enum Severity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

enum DiagnosisBasis {
  CLINICAL
  IMAGING
  HISTOLOGY
  UNKNOWN
}

enum TreatmentType {
  OBSERVATION
  PROPRANOLOL
  OTHER_MEDICATION
  LASER
  SCLEROTHERAPY
  EMBOLIZATION
  SURGERY
  COMBINED
  OTHER
}

enum TreatmentOutcome {
  RESOLVED
  IMPROVED
  UNCHANGED
  WORSENED
  ONGOING
  UNKNOWN
}

model RegistryPatient {
  id           String @id @default(cuid())
  trackingCode String @unique // PSV-XXXX-XXXX

  // --- status & provenance ---
  status            RegistryStatus    @default(PENDING)
  source            RecordSource
  clinicianId       String?
  clinician         ClinicianProfile? @relation(fields: [clinicianId], references: [id], onDelete: SetNull)
  // Centres network: a centre-owned record stays private to its centre until the centre
  // shares it with NVAR (sharedWithNvar). NVAR queries must filter on this (lib/registry/visibility.ts).
  // Restrict (not SetNull): detaching a record from its centre would silently publish it to NVAR.
  centerId          String?
  center            Center?           @relation(fields: [centerId], references: [id], onDelete: Restrict)
  mrn               String?           @db.VarChar(40) // the centre's own patient number
  sharedWithNvar    Boolean           @default(false)
  sharedAt          DateTime?
  possibleDuplicate Boolean           @default(false)
  duplicateOfId     String? // set when status = DUPLICATE
  publicReason      String?           @db.Text // shown in status lookup when REJECTED (non-PII)
  internalNote      String?           @db.Text // admin-only (non-PII policy; clinical remarks go to Diagnosis.notes 🔐)
  verifiedAt        DateTime?
  verifiedById      String?

  // --- PII (🔐 all encrypted) ---
  fullName     String  @db.Text // 🔐 required
  guardianName String? @db.Text // 🔐 required when minor
  cnic         String  @db.Text // 🔐 patient or guardian CNIC (13 digits)
  phone        String  @db.Text // 🔐 required
  altPhone     String? @db.Text // 🔐
  email        String? @db.Text // 🔐
  address      String? @db.Text // 🔐 street address
  dob          String  @db.Text // 🔐 ISO date string (full DOB, owner decision)

  // --- blind indexes (#, hex64) ---
  cnicHash  String @db.VarChar(64)
  phoneHash String @db.VarChar(64)

  // --- non-PII demographics (plaintext, used for stats) ---
  gender     Gender
  province   Province
  district   String // city/district name (free text from curated list)
  birthYear  Int // derived at write time from dob (for age-band stats)
  birthMonth Int // 1-12, derived
  isMinor    Boolean  @default(false)

  // --- consent (plaintext booleans + metadata) ---
  consentRegistry Boolean // required true
  consentContact  Boolean  @default(false)
  consentResearch Boolean  @default(false)
  consentGuardian Boolean  @default(false) // guardian declaration when minor
  consentCentre   Boolean  @default(false) // agreed to be registered with / stored by the centre
  consentVersion  String   @default("v1")
  consentAt       DateTime @default(now())

  diagnoses    RegistryDiagnosis[]
  encounters   Encounter[]
  appointments Appointment[]
  documents    PatientDocument[]
  caseShares   CaseShare[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([centerId, mrn])
  @@index([status])
  @@index([province])
  @@index([cnicHash])
  @@index([phoneHash])
  @@index([status, province])
  @@index([createdAt])
  @@index([centerId, createdAt])
  @@map("registry_patient")
}

model RegistryDiagnosis {
  id        String          @id @default(cuid())
  patientId String
  patient   RegistryPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  conditionSlug   String // one of data/conditions.ts slugs or 'other' | 'not-sure'
  conditionOther  String? // free text label when slug = 'other' (non-PII, short)
  issvaCategory   IssvaCategory  @default(UNCLASSIFIED)
  bodySite        String // affected area (curated list value, e.g. 'head-neck')
  onset           Onset          @default(UNKNOWN)
  doctorDiagnosed String         @default("unsure") // 'yes' | 'no' | 'unsure' (self-enroll)
  severity        Severity       @default(UNKNOWN) // clinician submissions
  basis           DiagnosisBasis @default(UNKNOWN) // clinician submissions
  facility        String? // diagnosing facility name (public institution name, non-PII)
  notes           String?        @db.Text // 🔐 clinical notes / treatment history free text

  treatments RegistryTreatment[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([patientId])
  @@index([conditionSlug])
  @@map("registry_diagnosis")
}

model RegistryTreatment {
  id          String            @id @default(cuid())
  diagnosisId String
  diagnosis   RegistryDiagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  type     TreatmentType
  facility String? // institution name (non-PII)
  year     Int?
  outcome  TreatmentOutcome @default(UNKNOWN)

  // Centre journey: logged at a visit (docs/centres/PLAN.md). Null for NVAR-entered treatments.
  date          DateTime?
  drug          String?    @db.VarChar(120)
  dose          String?    @db.VarChar(120)
  complications String?    @db.Text // 🔐
  encounterId   String?
  encounter     Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([diagnosisId])
  @@map("registry_treatment")
}

model ClinicianProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pmcNumber    String    @db.Text // 🔐 PMDC/PMC registration number
  pmcHash      String    @db.VarChar(64) // # dedup blind index
  specialty    String
  facility     String
  city         String
  province     Province
  approved     Boolean   @default(false)
  approvedAt   DateTime?
  approvedById String?

  patients  RegistryPatient[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([approved])
  @@index([pmcHash])
  @@map("clinician_profile")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // null = anonymous/system
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole String? // snapshot: 'admin' | 'clinician' | 'public' | 'system'
  action    String // AuditAction constant (see DATA-MODEL §3)
  entity    String // 'RegistryPatient' | 'ClinicianProfile' | 'Export' | 'Auth'
  entityId  String?
  meta      Json? // NON-PII context only (filters, counts, reason codes)
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

/// ---------------- Centres network (docs/centres/PLAN.md) ----------------

enum CenterType {
  PUBLIC
  PRIVATE
  TRUST
}

enum CenterStatus {
  APPLIED
  APPROVED
  REJECTED
  SUSPENDED
}

enum CenterTier {
  MEMBER
  ACCREDITED
  EXCELLENCE
}

enum CenterRole {
  OWNER
  DOCTOR
  NURSE
  RECEPTION
}

enum PaymentMethod {
  BANK
  JAZZCASH
  EASYPAISA
  RAAST
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Center {
  id   String @id @default(cuid())
  slug String @unique

  nameEn String
  nameUr String?
  type   CenterType

  city     String
  province Province
  address  String   @db.Text
  phone    String
  email    String
  website  String?
  lat      Float?
  lng      Float?

  services   Json // string[] of CENTER_SERVICES keys
  conditions Json // string[] of condition slugs

  licenceNumber  String
  headDoctorName String
  headDoctorPmc  String @db.Text // 🔐 PMDC/PMC registration number
  headDoctorHash String @db.VarChar(64) // # dedup blind index

  status              CenterStatus @default(APPLIED)
  tier                CenterTier   @default(MEMBER)
  statusReason        String?      @db.Text // public-safe reason shown to the owner on reject/suspend
  approvedAt          DateTime?
  approvedById        String?
  membershipExpiresAt DateTime? // null until the first payment is verified
  lastReminderAt      DateTime?

  members        CenterMember[]
  payments       CenterPayment[]
  patients       RegistryPatient[]
  appointments   Appointment[]
  encounters     Encounter[]
  documents      PatientDocument[]
  sharesSent     CaseShare[]       @relation("SharesSent")
  sharesReceived CaseShare[]       @relation("SharesReceived")
  mdtPosts       MdtPost[]
  mdtComments    MdtComment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status])
  @@index([province])
  @@index([headDoctorHash])
  @@map("center")
}

model CenterMember {
  id       String     @id @default(cuid())
  centerId String
  center   Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  userId   String     @unique
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     CenterRole
  active   Boolean    @default(true)

  createdAt DateTime @default(now())

  @@index([centerId])
  @@map("center_member")
}

model CenterPayment {
  id       String        @id @default(cuid())
  centerId String
  center   Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  amount   Int           @default(12000) // PKR
  method   PaymentMethod
  txnRef   String // transaction / reference id typed by the centre
  paidOn   DateTime

  status       PaymentStatus @default(PENDING)
  rejectReason String?       @db.Text
  verifiedAt   DateTime?
  verifiedById String?
  periodStart  DateTime? // set on VERIFY
  periodEnd    DateTime? // set on VERIFY

  createdAt DateTime @default(now())

  @@index([centerId])
  @@index([status])
  @@map("center_payment")
}

/// ---------------- Centre patient journey (docs/centres/PLAN.md) ----------------

enum AppointmentKind {
  FIRST_VISIT
  FOLLOW_UP
  PROCEDURE
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  MISSED
  CANCELLED
}

enum ResponseScore {
  WORSE
  STABLE
  PARTIAL
  COMPLETE
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patient     RegistryPatient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  centerId    String
  center      Center            @relation(fields: [centerId], references: [id], onDelete: Restrict)
  startsAt    DateTime
  kind        AppointmentKind   @default(FOLLOW_UP)
  status      AppointmentStatus @default(SCHEDULED)
  note        String?           @db.Text // 🔐
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId, startsAt])
  @@index([patientId])
  @@map("appointment")
}

model Encounter {
  id        String          @id @default(cuid())
  patientId String
  patient   RegistryPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  centerId  String
  center    Center          @relation(fields: [centerId], references: [id], onDelete: Restrict)
  authorId  String?
  author    User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)

  date           DateTime
  notes          String?        @db.Text // 🔐
  lesionSizeCm   Float?
  painScore      Int? // 0-10
  responseScore  ResponseScore?
  plan           String?        @db.Text // 🔐
  nextReviewDate DateTime?

  treatments RegistryTreatment[]
  createdAt  DateTime            @default(now())

  @@index([patientId, date])
  @@index([centerId])
  @@map("encounter")
}

enum DocumentKind {
  PHOTO
  REPORT
  IMAGING
  OTHER
}

/// An uploaded clinical photo/report. The bytes live encrypted on disk (lib/registry/storage.ts);
/// only metadata is here. fileName can contain a patient's name, so it is encrypted too.
model PatientDocument {
  id        String          @id @default(cuid())
  patientId String
  patient   RegistryPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  centerId  String
  center    Center          @relation(fields: [centerId], references: [id], onDelete: Restrict)

  kind               DocumentKind
  fileName           String            @db.Text // 🔐
  mime               String            @db.VarChar(40) // sniffed from the bytes, never client-declared
  size               Int // plaintext bytes
  storageKey         String            @unique @db.VarChar(64)
  consentForTeaching Boolean           @default(false) // may be attached to de-identified MDT posts
  mdtPosts           MdtPostDocument[]
  uploadedById       String?

  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([centerId])
  @@map("patient_document")
}

/// ---------------- Sharing between centres + MDT board (docs/centres/PLAN.md) ----------------

enum ShareType {
  REFERRAL // identified: on accept the receiving centre gets its own copy of the record
  SECOND_OPINION // de-identified summary, read-only, answered with a written opinion
}

enum ShareStatus {
  SENT
  ACCEPTED // referral accepted; copiedPatientId is the receiving centre's record
  DECLINED
  COMPLETED // second opinion answered
}

model CaseShare {
  id           String          @id @default(cuid())
  patientId    String
  patient      RegistryPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fromCenterId String
  fromCenter   Center          @relation("SharesSent", fields: [fromCenterId], references: [id], onDelete: Restrict)
  toCenterId   String
  toCenter     Center          @relation("SharesReceived", fields: [toCenterId], references: [id], onDelete: Restrict)

  type            ShareType
  status          ShareStatus @default(SENT)
  note            String?     @db.Text // 🔐 sender's clinical summary / reason
  response        String?     @db.Text // 🔐 the opinion, or the reason for declining
  copiedPatientId String? // referral accepted: the receiving centre's record
  createdById     String?
  respondedById   String?

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([fromCenterId, createdAt])
  @@index([toCenterId, status])
  @@index([patientId])
  @@map("case_share")
}

enum MdtStatus {
  OPEN
  RESOLVED
  HIDDEN // removed by PSOVA moderation
}

/// De-identified case for discussion across centres. Deliberately has NO link to a patient.
model MdtPost {
  id       String  @id @default(cuid())
  centerId String
  center   Center  @relation(fields: [centerId], references: [id], onDelete: Restrict)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  title         String    @db.VarChar(160)
  summary       String    @db.Text
  gender        Gender?
  ageBand       String?   @db.VarChar(20)
  province      Province?
  conditionSlug String?   @db.VarChar(80)
  bodySite      String?   @db.VarChar(40)
  status        MdtStatus @default(OPEN)

  comments  MdtComment[]
  documents MdtPostDocument[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([centerId])
  @@map("mdt_post")
}

model MdtComment {
  id       String  @id @default(cuid())
  postId   String
  post     MdtPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  centerId String
  center   Center  @relation(fields: [centerId], references: [id], onDelete: Restrict)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  body      String   @db.Text
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@map("mdt_comment")
}

/// Teaching-consented documents attached to a post (so other centres can open exactly these).
model MdtPostDocument {
  postId     String
  post       MdtPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  documentId String
  document   PatientDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([postId, documentId])
  @@map("mdt_post_document")
}
